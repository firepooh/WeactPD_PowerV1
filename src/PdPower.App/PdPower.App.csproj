<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PdPower.Core\PdPower.Core.csproj" />
    <ProjectReference Include="..\PdPower.Mcp\PdPower.Mcp.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\..\GUI\icon\pd-power.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 창 타이틀바·작업 표시줄 아이콘용. 원본은 GUI\icon 하나만 유지한다. -->
  <ItemGroup>
    <Resource Include="..\..\GUI\icon\pd-power.ico" Link="Assets\pd-power.ico" />
  </ItemGroup>

  <!-- 측정값 표시 서체 (목업 지정 Chivo Mono, OFL 라이선스 — Fonts\OFL.txt) -->
  <ItemGroup>
    <Resource Include="Fonts\ChivoMono-Regular.ttf" />
  </ItemGroup>

</Project>
