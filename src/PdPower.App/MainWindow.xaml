<Window x:Class="PdPower.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PdPower.App.ViewModels"
        xmlns:ctl="clr-namespace:PdPower.App.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="PD Power Tool" Height="680" Width="1000" MinHeight="540" MinWidth="860"
        Icon="pack://application:,,,/Assets/pd-power.ico"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}"
        FontSize="13" FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- 디자인은 창 전체를 하나의 면으로 다룬다: 외곽 여백 없음, 레일과 메인은 헤어라인으로만 구분 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196" MinWidth="176" MaxWidth="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════ 좌측 레일 (#FAFAF9 면) ══════════════════ -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0">
            <!-- PD/PORT 는 바닥 고정(Auto), 남는 높이는 프리셋 카드가 받는다.
                 창이 작아도 PORT 카드가 밀려나지 않아야 한다 — 없으면 연결 자체가 불가능하다. -->
            <Grid Margin="12,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="96" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 로고 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,0,0,10">
                    <Border Width="18" Height="18" CornerRadius="5" Background="{StaticResource AccentBrush}"
                            VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Margin="9,0,0,0">
                        <TextBlock Text="PD Power" FontSize="13" FontWeight="SemiBold" />
                        <!-- 버전은 Directory.Build.props 에서 오고 CI 가 덮어쓴다. 툴팁에 커밋 해시까지 -->
                        <TextBlock Text="{Binding AppVersion, StringFormat={}v{0}}"
                                   ToolTip="{Binding AppVersionFull}"
                                   Style="{StaticResource MicroMono}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 내비 -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <Button Content="Monitor" Command="{Binding ShowMonitorCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonitorView}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Setup" Margin="0,2,0,0" Command="{Binding ShowSetupCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSetupView}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Log" Margin="0,2,0,0" Command="{Binding ShowLogCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLogView}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- 프리셋 -->
                <Border Grid.Row="2" Style="{StaticResource HairlineCard}" Background="Transparent" Padding="10,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="Presets" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="LOCKED" Style="{StaticResource MicroMono}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding OutputEnabled, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>

                        <!-- 출력 중에는 CanExecute 가 false 라 각 행이 자동으로 흐려진다 -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Presets}" Grid.IsSharedSizeScope="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PresetItem}">
                                    <!-- 목업의 프리셋 카드: 행마다 헤어라인 테두리, 활성 행은 액센트 테두리 + 채운 칩 -->
                                    <Button Margin="0,0,0,5"
                                            Command="{Binding DataContext.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Id}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PresetRow}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <!-- 숫자는 오른쪽 정렬, 단위는 분리 — SharedSizeGroup 으로 행 간 열 폭을 맞춘다 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="PresetVolts" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="PresetAmps" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid.Resources>
                                                <!-- 숫자: 진한 색, 활성이면 액센트 -->
                                                <Style x:Key="PresetNumber" TargetType="TextBlock">
                                                    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                                                    <Setter Property="FontSize" Value="11" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="TextAlignment" Value="Right" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextRailValueBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentDeepBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                                <!-- 단위: 항상 연한 색 -->
                                                <Style x:Key="PresetUnit" TargetType="TextBlock">
                                                    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                                                    <Setter Property="FontSize" Value="10" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                </Style>
                                            </Grid.Resources>

                                            <Border Grid.Column="0" Width="26" Height="22" CornerRadius="5">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource SurfaceSunkBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Label}" FontFamily="{StaticResource MonoFont}"
                                                           FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <TextBlock Grid.Column="2" Text="{Binding VoltsText}"
                                                       Style="{StaticResource PresetNumber}" />
                                            <TextBlock Grid.Column="3" Text="V" Margin="3,0,0,0"
                                                       Style="{StaticResource PresetUnit}" />
                                            <TextBlock Grid.Column="4" Text="{Binding AmpsText}" Margin="12,0,0,0"
                                                       Style="{StaticResource PresetNumber}" />
                                            <TextBlock Grid.Column="5" Text="A" Margin="3,0,2,0"
                                                       Style="{StaticResource PresetUnit}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- PD 입력 -->
                <Border Grid.Row="3" Style="{StaticResource RailBox}" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,7">
                            <TextBlock Text="PD INPUT" Style="{StaticResource RailSectionLabel}" />
                            <TextBlock Style="{StaticResource FooterMono}" HorizontalAlignment="Right"
                                       Text="{Binding InputVolts, StringFormat={}{0:F2} V}" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 스테퍼 알약: 테두리 하나 안에서 내부 헤어라인으로만 나눈다 -->
                            <Border Grid.Column="0" Style="{StaticResource StepperPill}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="−" Width="20" Style="{StaticResource StepGlyph}"
                                            FontSize="12" Command="{Binding NudgePdCommand}" CommandParameter="-1" />
                                    <Rectangle Grid.Column="1" Style="{StaticResource PillDivider}" />
                                    <TextBlock Grid.Column="2" Padding="0,5" HorizontalAlignment="Center"
                                               FontFamily="{StaticResource MonoFont}" FontSize="12"
                                               Text="{Binding SelectedPdVoltage, StringFormat={}{0} V}" />
                                    <Rectangle Grid.Column="3" Style="{StaticResource PillDivider}" />
                                    <Button Grid.Column="4" Content="+" Width="20" Style="{StaticResource StepGlyph}"
                                            FontSize="12" Command="{Binding NudgePdCommand}" CommandParameter="1" />
                                </Grid>
                            </Border>

                            <Button Grid.Column="1" Content="Set" Margin="6,0,0,0" Padding="10,5"
                                    Style="{StaticResource AccentButton}" FontSize="11"
                                    Command="{Binding SetPdVoltageCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 포트 -->
                <Border Grid.Row="4" Style="{StaticResource RailBox}" Margin="0,8,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,7">
                            <TextBlock Text="PORT" Style="{StaticResource RailSectionLabel}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReconnecting}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource CurrentBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding LinkLabel}" Style="{StaticResource MicroMono}"
                                           Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- 목록은 드롭다운을 열 때 갱신한다 — 별도 Refresh 버튼이 필요 없다 -->
                        <ComboBox AutomationProperties.AutomationId="PortSelector"
                                  Style="{StaticResource FlatComboBox}"
                                  ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}"
                                  DropDownOpened="OnPortDropDownOpened"
                                  IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBool}}" />

                        <Button Margin="0,7,0,0" AutomationProperties.AutomationId="ConnectButton">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PortActionButton}">
                                    <Setter Property="Content" Value="Connect" />
                                    <Setter Property="Command" Value="{Binding ConnectCommand}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Content" Value="Disconnect" />
                                            <Setter Property="Command" Value="{Binding DisconnectCommand}" />
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                      Background="Transparent" ResizeBehavior="PreviousAndNext" />

        <!-- ══════════════════ 메인 ══════════════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 헤더: 아래쪽 헤어라인으로 구분 -->
            <Border Grid.Row="0" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1"
                    Padding="22,14">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Monitor" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DeviceName}" FontSize="13" Margin="10,0,0,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextTertiaryBrush}" />
                    </StackPanel>

                    <!-- 상태 칩: 색 면이 아니라 점 + 테두리 (디자인 기준) -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="6"
                            Padding="11,5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConnectionState}" Value="ONLINE">
                                                <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ConnectionState}" Value="RECONNECT">
                                                <Setter Property="Fill" Value="{StaticResource CurrentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionState}" FontSize="12" FontWeight="SemiBold"
                                       Margin="7,0,0,0" Foreground="#3D3D38" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 측정 + 제어 스트립: 한 박스, 세로 헤어라인 3분할, 각 칸은 위(측정)/아래(제어) 2단 -->
            <Border Grid.Row="1" Style="{StaticResource HairlineCard}" Margin="22,18,22,0" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ── 전압 ── -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- 캡션이 단위(V)를 대신하고 숫자를 최대로 키운다 — 목업 개정판 -->
                        <StackPanel Grid.Row="0" Margin="18,14,18,12">
                            <TextBlock Text="V" Style="{StaticResource CellCaption}" />
                            <TextBlock Text="{Binding MeasuredVolts, StringFormat={}{0:F3}}"
                                       Style="{StaticResource MeasureValueBig}" />
                        </StackPanel>
                        <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}" Padding="14,10"
                                BorderBrush="{StaticResource HairlineSoftBrush}" BorderThickness="0,1,0,0"
                                Tag="voltage" MouseWheel="OnStepperMouseWheel">
                            <StackPanel>
                                <TextBlock Text="Set voltage" Style="{StaticResource ControlCaption}" Margin="0,0,0,7" />
                                <Border Style="{StaticResource StepperPill}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="−" Style="{StaticResource StepGlyph}"
                                                Command="{Binding NudgeVoltsCommand}" CommandParameter="-1" />
                                        <Rectangle Grid.Column="1" Style="{StaticResource PillDivider}" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,6"
                                                    HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding SetVolts, StringFormat={}{0:F3}}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="13" />
                                            <TextBlock Text="V" FontSize="11" Margin="3,0,0,0"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       VerticalAlignment="Bottom" />
                                        </StackPanel>
                                        <Rectangle Grid.Column="3" Style="{StaticResource PillDivider}" />
                                        <Button Grid.Column="4" Content="+" Style="{StaticResource StepGlyph}"
                                                Command="{Binding NudgeVoltsCommand}" CommandParameter="1" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Rectangle Grid.Column="1" Fill="{StaticResource HairlineBrush}" />

                    <!-- ── 전류 ── -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="18,14,18,12">
                            <TextBlock Text="C" Style="{StaticResource CellCaption}" />
                            <TextBlock Text="{Binding MeasuredAmps, StringFormat={}{0:F3}}"
                                       Style="{StaticResource MeasureValueBig}" />
                        </StackPanel>
                        <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}" Padding="14,10"
                                BorderBrush="{StaticResource HairlineSoftBrush}" BorderThickness="0,1,0,0"
                                Tag="current" MouseWheel="OnStepperMouseWheel">
                            <StackPanel>
                                <TextBlock Text="Current limit" Style="{StaticResource ControlCaption}" Margin="0,0,0,7" />
                                <Border Style="{StaticResource StepperPill}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="−" Style="{StaticResource StepGlyph}"
                                                Command="{Binding NudgeAmpsCommand}" CommandParameter="-0.1" />
                                        <Rectangle Grid.Column="1" Style="{StaticResource PillDivider}" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,6"
                                                    HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding SetAmps, StringFormat={}{0:F3}}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="13" />
                                            <TextBlock Text="A" FontSize="11" Margin="3,0,0,0"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       VerticalAlignment="Bottom" />
                                        </StackPanel>
                                        <Rectangle Grid.Column="3" Style="{StaticResource PillDivider}" />
                                        <Button Grid.Column="4" Content="+" Style="{StaticResource StepGlyph}"
                                                Command="{Binding NudgeAmpsCommand}" CommandParameter="0.1" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Rectangle Grid.Column="3" Fill="{StaticResource HairlineBrush}" />

                    <!-- ── 전력 + 출력 ── -->
                    <Grid Grid.Column="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- 전력(W) + 누적 전력량(Wh) 상하 2단 — 목업 개정판 -->
                        <StackPanel Grid.Row="0" Margin="18,14,18,12">
                            <Grid>
                                <TextBlock Text="P" Style="{StaticResource CellCaption}" Margin="0"
                                           VerticalAlignment="Bottom" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding MeasuredWatts, StringFormat={}{0:F2}}"
                                               Style="{StaticResource MeasureValueMid}" />
                                    <TextBlock Text="W" Style="{StaticResource MeasureUnit}"
                                               VerticalAlignment="Bottom" Margin="5,0,0,3" />
                                </StackPanel>
                            </Grid>

                            <Rectangle Height="1" Fill="{StaticResource HairlineSoftBrush}" Margin="0,10" />

                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <TextBlock Text="E" Style="{StaticResource CellCaption}" Margin="0"
                                               VerticalAlignment="Center" />
                                    <!-- 누적값만 초기화 — Trend 히스토리는 유지 -->
                                    <Button Content="RST" Margin="8,0,0,0" Padding="6,2"
                                            Style="{StaticResource GhostButton}"
                                            FontFamily="{StaticResource MonoFont}" FontSize="9"
                                            AutomationProperties.AutomationId="EnergyResetButton"
                                            ToolTip="누적 전력량 초기화 (그래프 히스토리는 유지)"
                                            Command="{Binding ResetEnergyCommand}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding EnergyText}"
                                               Style="{StaticResource MeasureValueMid}"
                                               Foreground="{StaticResource TextRailValueBrush}" />
                                    <TextBlock Text="Wh" Style="{StaticResource MeasureUnit}"
                                               VerticalAlignment="Bottom" Margin="5,0,0,3" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}" Padding="14,10"
                                BorderBrush="{StaticResource HairlineSoftBrush}" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,7">
                                    <TextBlock Text="Output" Style="{StaticResource ControlCaption}" />
                                    <TextBlock Text="{Binding RegulationLabel}" HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MicroMono}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RegulationLabel}" Value="CC">
                                                        <Setter Property="Foreground" Value="{StaticResource CurrentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RegulationLabel}" Value="OC">
                                                        <Setter Property="Foreground" Value="{StaticResource CurrentBrush}" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- ON│OFF 세그먼트: 활성 칸만 채운다 -->
                                <Border Style="{StaticResource StepperPill}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" CornerRadius="6,0,0,6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OutputEnabled}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Button Content="ON" Command="{Binding OutputOnCommand}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OutputEnabled}" Value="True">
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Border>

                                        <Rectangle Grid.Column="1" Style="{StaticResource PillDivider}" />

                                        <Border Grid.Column="2" CornerRadius="0,6,6,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceSunkBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OutputEnabled}" Value="True">
                                                            <Setter Property="Background" Value="Transparent" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Button Content="OFF" Command="{Binding OutputOffCommand}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OutputEnabled}" Value="False">
                                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Trend (Monitor) / Log — 레일 내비로 전환 -->
            <Grid Grid.Row="2" Margin="22,14,22,18">

                <!-- Trend -->
                <Border Style="{StaticResource HairlineCard}" Padding="16,14"
                        Visibility="{Binding IsMonitorView, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 섹션 헤더: 제목 + 범례 + 범위·Fit·Freeze·CSV·Clear·Hide -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Trend" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                <Rectangle Width="12" Height="2" Margin="14,0,5,0" VerticalAlignment="Center"
                                           Fill="{StaticResource AccentBrush}" />
                                <TextBlock Text="Voltage (V)" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                           Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                <Rectangle Width="12" Height="2" Margin="12,0,5,0" VerticalAlignment="Center"
                                           Fill="{StaticResource CurrentBrush}" />
                                <TextBlock Text="Current (A)" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                           Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <!-- 시간 범위. 창을 바꾸면 저장 간격도 함께 조정된다 -->
                                <Button Content="1m" Command="{Binding SelectRangeCommand}" CommandParameter="60">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RangeButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedRangeSeconds}" Value="60">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceSunkBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="5m" Command="{Binding SelectRangeCommand}" CommandParameter="300">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RangeButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedRangeSeconds}" Value="300">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceSunkBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="1h" Command="{Binding SelectRangeCommand}" CommandParameter="3600">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RangeButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedRangeSeconds}" Value="3600">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceSunkBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Y축 방식. 휠로 조절하면 Manual 로 넘어가 둘 다 꺼진다 -->
                                <Button Content="Auto" Margin="10,0,0,0" Command="{Binding SetAutoScaleCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RangeButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding YScaleMode}" Value="Auto">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceSunkBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Fit" Command="{Binding SetFitScaleCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RangeButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding YScaleMode}" Value="Fit">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceSunkBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="CSV" Style="{StaticResource GhostButton}" Padding="8,4"
                                        Margin="10,0,0,0" Command="{Binding ExportCsvCommand}" />
                                <Button Content="Clear" Style="{StaticResource GhostButton}" Padding="8,4"
                                        Margin="6,0,0,0" Command="{Binding ClearHistoryCommand}" />
                                <Button Content="Hide" Style="{StaticResource GhostButton}" Padding="8,4"
                                        Margin="6,0,0,0" Command="{Binding ToggleTrendCommand}" />
                            </StackPanel>
                        </Grid>

                        <!-- 보이는 구간 통계 -->
                        <TextBlock Grid.Row="1" Style="{StaticResource FooterMono}" Margin="0,0,0,8">
                            <Run Text="V" Foreground="{StaticResource AccentBrush}" />
                            <Run Text="{Binding Stats.Volts.Min, StringFormat={}{0:F3}, Mode=OneWay}" /><Run Text=" /" />
                            <Run Text="{Binding Stats.Volts.Avg, StringFormat={}{0:F3}, Mode=OneWay}" /><Run Text=" /" />
                            <Run Text="{Binding Stats.Volts.Max, StringFormat={}{0:F3}, Mode=OneWay}" />
                            <Run Text="   A" Foreground="{StaticResource CurrentBrush}" />
                            <Run Text="{Binding Stats.Amps.Min, StringFormat={}{0:F3}, Mode=OneWay}" /><Run Text=" /" />
                            <Run Text="{Binding Stats.Amps.Avg, StringFormat={}{0:F3}, Mode=OneWay}" /><Run Text=" /" />
                            <Run Text="{Binding Stats.Amps.Max, StringFormat={}{0:F3}, Mode=OneWay}" />
                            <Run Text="   W" />
                            <Run Text="{Binding Stats.Watts.Min, StringFormat={}{0:F2}, Mode=OneWay}" /><Run Text=" /" />
                            <Run Text="{Binding Stats.Watts.Avg, StringFormat={}{0:F2}, Mode=OneWay}" /><Run Text=" /" />
                            <Run Text="{Binding Stats.Watts.Max, StringFormat={}{0:F2}, Mode=OneWay}" />
                            <Run Text="   min/avg/max ·" Foreground="{StaticResource TextMutedBrush}" />
                            <Run Text="{Binding SampleCount, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" />
                            <Run Text="samples" Foreground="{StaticResource TextMutedBrush}" />
                        </TextBlock>

                        <!-- 클릭으로 정지, 축 위 휠로 스케일 → 양방향 바인딩 -->
                        <ctl:TrendChart Grid.Row="2" Window="{Binding CurrentWindow}"
                                        ScaleMode="{Binding YScaleMode, Mode=TwoWay}"
                                        IsFrozen="{Binding IsFrozen, Mode=TwoWay}"
                                        Visibility="{Binding IsTrendVisible, Converter={StaticResource BoolToVisibility}}"
                                        VoltageBrush="{StaticResource AccentBrush}"
                                        CurrentBrush="{StaticResource CurrentBrush}"
                                        GridBrush="{StaticResource HairlineBrush}"
                                        AxisLabelBrush="{StaticResource TextMutedBrush}"
                                        ReadoutBackground="{StaticResource SurfaceBrush}"
                                        ReadoutForeground="{StaticResource TextBrush}" />

                        <Button Grid.Row="2" Content="Show trend graph" Style="{StaticResource GhostButton}"
                                Padding="16,8" FontSize="12"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Command="{Binding ToggleTrendCommand}"
                                Visibility="{Binding IsTrendHidden, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>

                <!-- Setup — 항목이 늘어나면 카드 높이를 넘으므로 스크롤로 감싼다 -->
                <Border Style="{StaticResource HairlineCard}" Padding="16,14"
                        Visibility="{Binding IsSetupView, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="Setup" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />

                        <!-- 설정 한 줄: 설명(좌) + 제어(우) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Over-current protection" FontSize="13"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="OCP" Style="{StaticResource MicroMono}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <!-- 휘발성이라는 설명은 바로 아래 저장 섹션이 하므로 여기서 반복하지 않는다 -->
                                <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           Text="임계값은 Current limit 설정값. 초과 후 약 200 ms 뒤 차단되고, 끄면 CC로 물려 출력이 유지됩니다." />
                            </StackPanel>

                            <Border Grid.Column="1" Style="{StaticResource StepperPill}" Width="132"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" CornerRadius="6,0,0,6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOcpEnabled}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Button Content="ON" Command="{Binding OcpOnCommand}"
                                                AutomationProperties.AutomationId="OcpOnButton">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOcpEnabled}" Value="True">
                                                            <Setter Property="Foreground" Value="White" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Border>

                                    <Rectangle Grid.Column="1" Style="{StaticResource PillDivider}" />

                                    <Border Grid.Column="2" CornerRadius="0,6,6,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource SurfaceSunkBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOcpEnabled}" Value="True">
                                                        <Setter Property="Background" Value="Transparent" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Button Content="OFF" Command="{Binding OcpOffCommand}"
                                                AutomationProperties.AutomationId="OcpOffButton">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOcpEnabled}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" Margin="0,14" />

                        <!-- 폴링 주기 (앱 설정, 장치와 무관) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Measurement interval" FontSize="13"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="0x85" Style="{StaticResource MicroMono}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           Text="READ_OUTPUT_DISPLAY 읽기 주기. 10 ms 단위, 10~500 ms. 장치 표시값 갱신이 더 느려서 10 ms 아래로는 새 데이터가 없습니다." />
                                <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMutedBrush}">
                                    <Run Text="현재 Trend 저장 간격" />
                                    <Run Text="{Binding StorageIntervalMs, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" /><Run Text=" ms" />
                                    <Run Text="— 선택한 시간 범위에서 유도됩니다. 이보다 촘촘한 샘플은 그래프에 저장되지 않습니다." />
                                </TextBlock>
                            </StackPanel>

                            <Border Grid.Column="1" Style="{StaticResource StepperPill}" Width="132"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="−" Style="{StaticResource StepGlyph}"
                                            AutomationProperties.AutomationId="PollIntervalDown"
                                            Command="{Binding NudgePollIntervalCommand}" CommandParameter="-1" />
                                    <Rectangle Grid.Column="1" Style="{StaticResource PillDivider}" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,6"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding PollIntervalMs}"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="13" />
                                        <TextBlock Text="ms" FontSize="11" Margin="3,0,0,0"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   VerticalAlignment="Bottom" />
                                    </StackPanel>
                                    <Rectangle Grid.Column="3" Style="{StaticResource PillDivider}" />
                                    <Button Grid.Column="4" Content="+" Style="{StaticResource StepGlyph}"
                                            AutomationProperties.AutomationId="PollIntervalUp"
                                            Command="{Binding NudgePollIntervalCommand}" CommandParameter="1" />
                                </Grid>
                            </Border>
                        </Grid>

                        <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" Margin="0,14" />

                        <!-- 상태·입력 읽기 배수 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="State read every N ticks" FontSize="13"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="0x82 · 0x8A" Style="{StaticResource MicroMono}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           Text="CV/CC/OC 와 입력 상태를 측정 주기의 몇 배로 읽을지. 1이면 매번 — OCP 트립(약 200 ms)의 CC→OC 전이를 놓치지 않으려면 실효 주기를 200 ms 아래로 두세요." />
                                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                                    <Run Text="실효 주기" />
                                    <Run Text="{Binding StatusIntervalMs, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" /><Run Text=" ms" />
                                </TextBlock>
                            </StackPanel>

                            <Border Grid.Column="1" Style="{StaticResource StepperPill}" Width="132"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="−" Style="{StaticResource StepGlyph}"
                                            Command="{Binding NudgeStatusDivisorCommand}" CommandParameter="-1" />
                                    <Rectangle Grid.Column="1" Style="{StaticResource PillDivider}" />
                                    <TextBlock Grid.Column="2" Padding="0,6" HorizontalAlignment="Center"
                                               FontFamily="{StaticResource MonoFont}" FontSize="13"
                                               Text="{Binding StatusDivisor, StringFormat={}×{0}}" />
                                    <Rectangle Grid.Column="3" Style="{StaticResource PillDivider}" />
                                    <Button Grid.Column="4" Content="+" Style="{StaticResource StepGlyph}"
                                            Command="{Binding NudgeStatusDivisorCommand}" CommandParameter="1" />
                                </Grid>
                            </Border>
                        </Grid>

                        <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" Margin="0,14" />

                        <!-- LCD 밝기 (BRIGHTNESS 0x08 / 0x88) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="LCD brightness" FontSize="13"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="1–100" Style="{StaticResource MicroMono}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           Text="트랙을 클릭하거나 손잡이를 끌어 조절합니다. 끌기가 멈춘 뒤 장치에 한 번만 기록됩니다." />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Slider Width="132" Style="{StaticResource FlatSlider}"
                                        AutomationProperties.AutomationId="BrightnessSlider"
                                        Minimum="1" Maximum="100"
                                        IsEnabled="{Binding IsConnected}"
                                        Value="{Binding BrightnessPercent, Mode=TwoWay}" />
                                <TextBlock Width="44" Margin="10,0,0,0" TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource MonoFont}" FontSize="13"
                                           Text="{Binding BrightnessPercent, StringFormat={}{0}%}" />
                            </StackPanel>
                        </Grid>

                        <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" Margin="0,14" />

                        <!-- AI 제어 — 앱 내장 MCP 서버 (장치 명령이 아니라 앱 기능) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="AI control server" FontSize="13"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="MCP" Style="{StaticResource MicroMono}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           Text="Claude 같은 AI가 이 앱을 통해 장치를 읽고 제어할 수 있게 합니다. localhost 전용이며, AI가 보낸 명령은 Log 화면에 [MCP] 로 남습니다." />
                                <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                           FontFamily="{StaticResource MonoFont}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="{Binding McpRegisterCommand, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Border Style="{StaticResource StepperPill}" Width="132">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" CornerRadius="6,0,0,6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMcpEnabled}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Button Content="ON" Command="{Binding McpOnCommand}"
                                                    AutomationProperties.AutomationId="McpOnButton">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMcpEnabled}" Value="True">
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Border>

                                        <Rectangle Grid.Column="1" Style="{StaticResource PillDivider}" />

                                        <Border Grid.Column="2" CornerRadius="0,6,6,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceSunkBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMcpEnabled}" Value="True">
                                                            <Setter Property="Background" Value="Transparent" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Button Content="OFF" Command="{Binding McpOffCommand}"
                                                    AutomationProperties.AutomationId="McpOffButton">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMcpEnabled}" Value="False">
                                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 등록 명령 복사 — Claude Code 터미널에 붙여넣기용 -->
                                <Button Content="Copy register cmd" Width="132" Margin="0,8,0,0" Padding="0,5"
                                        Style="{StaticResource GhostButton}"
                                        AutomationProperties.AutomationId="McpCopyButton"
                                        Command="{Binding CopyMcpRegisterCommand}" />
                            </StackPanel>
                        </Grid>

                        <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" Margin="0,14" />

                        <!-- 설정 저장 (SYSTEM_CONFIG_SAVE 0x44) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Save to device" FontSize="13"
                                               Foreground="{StaticResource TextBrush}" />
                                    <Border CornerRadius="4" Padding="5,1" Margin="8,0,0,0"
                                            Background="{StaticResource CurrentBrush}"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="UNSAVED" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="9" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           Text="아래 6개 항목의 현재 값이 한 번에 플래시로 저장됩니다. 개별 선택은 불가합니다." />

                                <!-- 저장 대상: 프로토콜 SYSTEM_CONFIG_SAVE 주석에 명시된 6가지.
                                     한글은 모노 폰트에서도 폭이 달라 공백 정렬이 안 되므로 Grid 로 맞춘다. -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="11" />
                                            <Setter Property="Margin" Value="0,0,16,2" />
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        </Style>
                                    </Grid.Resources>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="활성 프리셋 번호" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="프리셋 전압 / 전류" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="과전류 보호 (OCP)" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="출력 오프셋 보정" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="LCD 밝기" />
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="PD 요청 전압" />

                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="OUTPUT_ID" FontFamily="{StaticResource MonoFont}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="OUTPUT_DATA" FontFamily="{StaticResource MonoFont}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="OUTPUT_OCP_EN" FontFamily="{StaticResource MonoFont}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="OUTPUT_OFFSET_EN" FontFamily="{StaticResource MonoFont}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="BRIGHTNESS" FontFamily="{StaticResource MonoFont}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="INPUT_PD_VOLTAGE" FontFamily="{StaticResource MonoFont}" />

                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="0x03" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="0x04" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="0x06" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="0x07" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="0x08" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="5" Grid.Column="2" Text="0x0A" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextMutedBrush}" />
                                </Grid>

                                <TextBlock Margin="0,10,0,0" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="출력 on/off 와 방전 설정은 저장 대상이 아니라 전원 재인가 시 항상 초기화됩니다. UNSAVED 는 연결 이후 이 앱이 만든 변경만 추적합니다 — 플래시를 읽는 명령이 없어 장치에서 직접 바꾼 값은 알 수 없습니다." />
                            </StackPanel>

                            <Button Grid.Column="1" Content="Save" VerticalAlignment="Top" Width="132"
                                    Padding="0,7" Style="{StaticResource AccentButton}"
                                    AutomationProperties.AutomationId="SaveConfigButton"
                                    Command="{Binding SaveConfigCommand}" />
                        </Grid>

                        <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" Margin="0,14" />

                        <!-- About — 버전 확인용. 레일 표기는 짧으니 여기서 전체 버전을 보여준다 -->
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="About" FontSize="13" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{Binding AppVersion, StringFormat={}v{0}}"
                                           Style="{StaticResource MicroMono}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextTertiaryBrush}">
                                <Run Text="PD Power Tool" />
                                <Run Text="{Binding AppVersionFull, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                                <Run Text="— 태그 릴리즈는 커밋 해시가 붙고, dev 빌드는 -dev.N 이 붙습니다." />
                            </TextBlock>
                            <TextBlock Margin="0,4,0,0" FontSize="11">
                                <Hyperlink NavigateUri="https://github.com/firepooh/WeactPD_PowerV1/releases"
                                           RequestNavigate="OnNavigateUri"
                                           Foreground="{StaticResource AccentBrush}">GitHub Releases</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Log -->
                <Border Style="{StaticResource HairlineCard}" Padding="16,14"
                        Visibility="{Binding IsLogView, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Log" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                            <CheckBox Style="{StaticResource FlatCheckBox}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Content="Trace raw frames"
                                      IsChecked="{Binding IsFrameTraceEnabled}" />
                        </Grid>
                        <ListBox Grid.Row="1" Style="{StaticResource LogList}" ItemsSource="{Binding Log}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- 푸터: 위쪽 헤어라인 + #FAFAF9 면 -->
            <Border Grid.Row="3" Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="22,10">
                <Grid>
                    <TextBlock Style="{StaticResource FooterMono}">
                        <Run Text="SN " /><Run Text="{Binding SerialNumber, Mode=OneWay}" />
                        <Run Text="  ·  FW " /><Run Text="{Binding FirmwareVersion, Mode=OneWay}" />
                        <Run Text="  ·  " /><Run Text="{Binding InputState, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource FooterMono}"
                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="480" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
