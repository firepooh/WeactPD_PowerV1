<Window x:Class="PdPower.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PdPower.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="PD Power Tool" Height="610" Width="1000" MinHeight="520" MinWidth="820"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}"
        FontSize="13" FontFamily="Segoe UI"
        UseLayoutRounding="True">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <!-- 좌측 레일: 드래그로 110–320 px. 디자인안의 56 px 아이콘 모드 접힘은 아직 미구현. -->
            <ColumnDefinition Width="216" MinWidth="180" MaxWidth="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════ 좌측 레일 ══════════════ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- 로고 + 앱명 -->
                <StackPanel Orientation="Horizontal" Margin="4,0,0,16">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="P" Foreground="White" FontWeight="Bold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="PD Power Tool" FontWeight="SemiBold" FontSize="14"
                               VerticalAlignment="Center" Margin="9,0,0,0" />
                </StackPanel>

                <!-- 프리셋 M0–M4 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="PRESETS" Style="{StaticResource SectionTitle}" Margin="0" />
                            <TextBlock Text="LOCKED" Style="{StaticResource SectionTitle}" Margin="0"
                                       HorizontalAlignment="Right" Foreground="{StaticResource CurrentBrush}"
                                       Visibility="{Binding OutputEnabled, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>

                        <!-- 출력 중에는 SelectPresetCommand 의 CanExecute 가 false 라
                             버튼이 자동으로 비활성(opacity 0.45)된다. -->
                        <ItemsControl ItemsSource="{Binding Presets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PresetItem}">
                                    <Button Margin="0,0,0,4" HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Id}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="4" Padding="6,1"
                                                    Background="{StaticResource SurfaceAltBrush}">
                                                <TextBlock Text="{Binding Label}" FontFamily="{StaticResource MonoFont}"
                                                           FontSize="11" FontWeight="Bold" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Summary}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        <Setter Property="Background" Value="#F0F5FE" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- PD 입력 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="PD INPUT" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding PdVoltageOptions}"
                                      SelectedItem="{Binding SelectedPdVoltage}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Set" Style="{StaticResource FlatButton}"
                                    Margin="6,0,0,0" Command="{Binding SetPdVoltageCommand}" />
                        </Grid>
                        <TextBlock Margin="0,8,0,0" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="{Binding InputState, Mode=OneWay}" />
                            <Run Text="  " />
                            <Run Text="{Binding InputVolts, StringFormat={}{0:F3} V, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 포트 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="PORT" Style="{StaticResource SectionTitle}" />
                        <ComboBox AutomationProperties.AutomationId="PortSelector"
                                  ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}"
                                  IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBool}}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Connect" Style="{StaticResource AccentButton}"
                                    AutomationProperties.AutomationId="ConnectButton"
                                    Margin="0,0,3,0" Command="{Binding ConnectCommand}" />
                            <Button Grid.Column="1" Content="Disconnect" Style="{StaticResource FlatButton}"
                                    AutomationProperties.AutomationId="DisconnectButton"
                                    Margin="3,0,0,0" Command="{Binding DisconnectCommand}" />
                        </Grid>
                        <Button Content="Refresh ports" Style="{StaticResource FlatButton}" Margin="0,6,0,0"
                                Command="{Binding RefreshPortsCommand}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                      Background="Transparent" ResizeBehavior="PreviousAndNext" />

        <!-- ══════════════ 메인 ══════════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 헤더 -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Monitor" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DeviceName}" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
                <Border CornerRadius="11" Padding="10,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource TextMutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="RUN">
                                    <Setter Property="Background" Value="{StaticResource OkBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="IDLE">
                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ConnectionState}" Foreground="White" FontSize="11" FontWeight="Bold" />
                </Border>
            </Grid>

            <!-- 측정 + 제어 스트립 -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 전압 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="4,0,12,10">
                        <TextBlock Text="Voltage (V)" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding MeasuredVolts, StringFormat={}{0:F3}}" Style="{StaticResource Measurement}" />
                    </StackPanel>
                    <Grid Grid.Row="1" Grid.Column="0" Margin="4,0,12,0"
                          Tag="voltage" MouseWheel="OnStepperMouseWheel" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="−" Style="{StaticResource StepButton}"
                                Command="{Binding NudgeVoltsCommand}" CommandParameter="-1" />
                        <Border Grid.Column="1" Style="{StaticResource SubCard}" Margin="6,0" Padding="4">
                            <TextBlock Text="{Binding SetVolts, StringFormat={}{0:F3} V}" Style="{StaticResource Setpoint}" />
                        </Border>
                        <Button Grid.Column="2" Content="+" Style="{StaticResource StepButton}"
                                Command="{Binding NudgeVoltsCommand}" CommandParameter="1" />
                    </Grid>

                    <Rectangle Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Fill="{StaticResource DividerBrush}" />

                    <!-- 전류 -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="12,0,12,10">
                        <TextBlock Text="Current (A)" Style="{StaticResource Caption}" Foreground="{StaticResource CurrentBrush}" />
                        <TextBlock Text="{Binding MeasuredAmps, StringFormat={}{0:F3}}" Style="{StaticResource Measurement}" />
                    </StackPanel>
                    <Grid Grid.Row="1" Grid.Column="2" Margin="12,0"
                          Tag="current" MouseWheel="OnStepperMouseWheel" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="−" Style="{StaticResource StepButton}"
                                Command="{Binding NudgeAmpsCommand}" CommandParameter="-0.1" />
                        <Border Grid.Column="1" Style="{StaticResource SubCard}" Margin="6,0" Padding="4">
                            <TextBlock Text="{Binding SetAmps, StringFormat={}{0:F3} A}" Style="{StaticResource Setpoint}" />
                        </Border>
                        <Button Grid.Column="2" Content="+" Style="{StaticResource StepButton}"
                                Command="{Binding NudgeAmpsCommand}" CommandParameter="0.1" />
                    </Grid>

                    <Rectangle Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" Fill="{StaticResource DividerBrush}" />

                    <!-- 전력 + 출력 제어 -->
                    <StackPanel Grid.Row="0" Grid.Column="4" Margin="12,0,4,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Power (W)" Style="{StaticResource Caption}" />
                            <Border CornerRadius="4" Padding="5,1" Margin="8,0,0,0"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
                                <TextBlock Text="{Binding Regulation}" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding MeasuredWatts, StringFormat={}{0:F3}}" Style="{StaticResource Measurement}" />
                    </StackPanel>
                    <Grid Grid.Row="1" Grid.Column="4" Margin="12,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding ToggleOutputCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                    <Setter Property="Content" Value="Output ON" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OutputEnabled}" Value="True">
                                            <Setter Property="Content" Value="Output OFF" />
                                            <Setter Property="Background" Value="{StaticResource CurrentBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource CurrentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="1" Content="Save" Style="{StaticResource FlatButton}"
                                Margin="6,0,0,0" Command="{Binding SaveConfigCommand}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Trend / Log -->
            <TabControl Grid.Row="2" BorderThickness="0" Background="Transparent" Padding="0">
                <TabItem Header="Trend">
                    <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                        <Grid>
                            <!-- TODO: LiveCharts2 로 듀얼축(좌 전압 20 V / 우 전류 3 A) 차트 교체 -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Trend chart" Style="{StaticResource SectionTitle}"
                                           HorizontalAlignment="Center" />
                                <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center">
                                    <Run Text="{Binding History.Count, Mode=OneWay}" />
                                    <Run Text="/ 64 samples buffered" />
                                </TextBlock>
                            </StackPanel>
                            <Button Content="Clear" Style="{StaticResource FlatButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding ClearHistoryCommand}" />
                        </Grid>
                    </Border>
                </TabItem>
                <TabItem Header="Log">
                    <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <CheckBox Grid.Row="0" Margin="2,0,0,6" FontSize="11"
                                      Content="Trace raw frames (250 ms 폴링당 6~8 프레임)"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      IsChecked="{Binding IsFrameTraceEnabled}" />
                            <ListBox Grid.Row="1" ItemsSource="{Binding Log}" BorderThickness="0" Background="Transparent"
                                     FontFamily="{StaticResource MonoFont}" FontSize="11"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>

            <!-- 푸터 -->
            <Grid Grid.Row="3" Margin="2,10,2,0">
                <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                           FontFamily="{StaticResource MonoFont}">
                    <Run Text="SN" /><Run Text=" " /><Run Text="{Binding SerialNumber, Mode=OneWay}" />
                    <Run Text="  ·  FW " /><Run Text="{Binding FirmwareVersion, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Right" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                           MaxWidth="520" />
            </Grid>
        </Grid>
    </Grid>
</Window>
